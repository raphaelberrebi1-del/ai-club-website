<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Pricing & Plans - AI Club Raanana</title>
    <meta name="description" content="Flexible pricing plans for AI Club - structured AI learning programs for children ages 8-18 in Raanana.">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.aikidz.club/pricing.html">
    <meta property="og:title" content="Pricing & Plans - AI Club Raanana">
    <meta property="og:description" content="Flexible pricing plans for AI Club - structured AI learning programs for children ages 8-18 in Raanana.">
    <meta property="og:image" content="https://www.aikidz.club/whatsapp-preview.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="AI Club - AI Education for Children">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:secure_url" content="https://www.aikidz.club/whatsapp-preview.jpg">
    <meta property="og:site_name" content="AI Club">
    <meta property="og:locale" content="en_US">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://www.aikidz.club/pricing.html">
    <meta property="twitter:title" content="Pricing & Plans - AI Club Raanana">
    <meta property="twitter:description" content="Flexible pricing plans for AI Club - structured AI learning programs for children ages 8-18 in Raanana.">
    <meta property="twitter:image" content="https://www.aikidz.club/whatsapp-preview.jpg">
    <meta property="twitter:image:alt" content="AI Club - AI Education for Children">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    <!-- Mobile Device Detection and Redirect -->
    <style>
        /* Chevron Cursor with Ribbon Trail */
        * {
            cursor: none !important;
        }

        .cursor-ring {
            width: 20px;
            height: 20px;
            position: fixed;
            pointer-events: none;
            z-index: 10001;
            transform: translate(-50%, -50%);
            transition: transform 0.08s ease-out;
        }

        .cursor-ring::before {
            content: '';
            position: absolute;
            width: 0;
            height: 0;
            border-left: 10px solid rgba(6, 182, 212, 0.9);
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            left: 50%;
            top: 50%;
            transform: translate(-30%, -50%);
        }

        .cursor-ring.hover::before {
            border-left-color: rgba(168, 85, 247, 0.9);
            border-left-width: 12px;
            border-top-width: 8px;
            border-bottom-width: 8px;
        }

        .cursor-trail-svg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10001;
        }

        .cursor-trail-path {
            fill: none;
            stroke: url(#trail-gradient);
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* Fixed magical background for entire page */
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial;
            background-color: #0a0a12;
            min-height: 100vh;
            position: relative;
        }

        .site-background {
            position: fixed;
            inset: 0;
            z-index: -10;
            pointer-events: none;
            background-image: url('/NEW-background.jpg?v=1');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            transform: translateZ(0);
        }

        .site-background::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1;
        }

        /* Desktop-specific background optimization */
        @media (min-width: 769px) {
            .site-background {
                background-image: url('/Desktop.background.png');
                background-size: cover;
                background-position: center center;
            }

            .site-background::after {
                background: transparent;
            }
        }

        /* Scroll-triggered animations */
        .fade-in-up {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .fade-in-up.animate {
            opacity: 1;
            transform: translateY(0);
        }

        .fade-in-up.delay-1 { transition-delay: 0.2s; }
        .fade-in-up.delay-2 { transition-delay: 0.4s; }
        .fade-in-up.delay-3 { transition-delay: 0.6s; }
        .fade-in-up.delay-4 { transition-delay: 0.8s; }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            25% { transform: translate(100px, -100px) rotate(90deg); }
            50% { transform: translate(200px, 50px) rotate(180deg); }
            75% { transform: translate(50px, 150px) rotate(270deg); }
        }

        .particle-1 { top: 20%; left: 10%; }
        .particle-2 { top: 60%; left: 80%; }
        .particle-3 { top: 40%; left: 50%; }

        /* Column hover effects */
        .pricing-table th,
        .pricing-table td {
            transition: all 0.3s ease;
        }

        .pricing-table th.column-hover,
        .pricing-table td.column-hover {
            background-color: rgba(255, 255, 255, 0.08) !important;
            transform: translateY(-4px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        @keyframes rollArrowDown {
            0% {
                transform: translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateY(100%);
                opacity: 0;
            }
            51% {
                transform: translateY(-100%);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes rollArrowUp {
            0% {
                transform: translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateY(-100%);
                opacity: 0;
            }
            51% {
                transform: translateY(100%);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* Navigation link roll animation */
        @keyframes rollTextDown {
            0% {
                transform: translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateY(100%);
                opacity: 0;
            }
            51% {
                transform: translateY(-100%);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes rollTextUp {
            0% {
                transform: translateY(0);
                opacity: 1;
            }
            50% {
                transform: translateY(-100%);
                opacity: 0;
            }
            51% {
                transform: translateY(100%);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .nav-link-roll {
            display: inline-block;
            position: relative;
            animation: rollTextUp 0.4s ease-in-out;
        }

        a:hover .nav-link-roll {
            animation: rollTextDown 0.4s ease-in-out;
        }

        /* Arrow roll - must come AFTER nav-link-roll to take precedence */
        .arrow-roll {
            display: inline-block;
            position: relative;
            animation: rollArrowUp 0.4s ease-in-out;
        }

        button:hover .arrow-roll {
            animation: rollArrowDown 0.4s ease-in-out;
        }

        a:hover .arrow-roll {
            animation: rollArrowDown 0.4s ease-in-out !important;
        }

        /* Robot Logo - No hover animation */
        .robot-logo {
            border-radius: 0.5rem;
        }

        /* Navigation Typography */
        nav a {
            font-family: 'Nunito', sans-serif;
            font-weight: 600;
            position: relative;
        }

        /* Hover underline effect for nav links */
        nav a:not(.register-btn):not(.lang-toggle) .nav-link-roll {
            position: relative;
            display: inline-block;
        }

        nav a:not(.register-btn):not(.lang-toggle):hover .nav-link-roll::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(to right, #22d3ee, #14b8a6);
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { width: 0; }
            to { width: 100%; }
        }

        /* ==========================================
           AGE GROUP CARD SELECTION STYLES
           ========================================== */

        /* Age card base styles with smooth transitions */
        .age-card {
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
            cursor: pointer;
        }

        /* Selected state for age group cards */
        .age-card.selected {
            border-width: 3px !important;
            border-color: rgba(6, 182, 212, 0.8) !important;
            background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(20, 184, 166, 0.15)) !important;
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 50px rgba(6, 182, 212, 0.4), 0 0 30px rgba(6, 182, 212, 0.2) !important;
        }

        /* Enhance the icon glow on selected cards */
        .age-card.selected .w-14 {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
        }

        /* Add a subtle pulse animation to selected cards */
        @keyframes pulseGlow {
            0%, 100% {
                box-shadow: 0 20px 50px rgba(6, 182, 212, 0.4), 0 0 30px rgba(6, 182, 212, 0.2);
            }
            50% {
                box-shadow: 0 20px 60px rgba(6, 182, 212, 0.5), 0 0 40px rgba(6, 182, 212, 0.3);
            }
        }

        .age-card.selected {
            animation: pulseGlow 2s ease-in-out infinite;
        }

        /* ==========================================
           PRICING TABLE ANIMATIONS
           ========================================== */

        /* Pricing table containers - hidden by default */
        .pricing-table-container {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                        transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        /* Show state for pricing tables */
        .pricing-table-container.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Value proposition section animations */
        #value-proposition-professional {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s,
                        transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s;
        }

        #value-proposition-professional.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* ==========================================
           RESPONSIVE ADJUSTMENTS
           ========================================== */

        /* Mobile: Stack age cards vertically with adjusted spacing */
        @media (max-width: 768px) {
            .age-card {
                margin-bottom: 1rem;
            }

            .age-card.selected {
                transform: translateY(-4px) scale(1.01);
            }

            /* Reduce animation intensity on mobile for better performance */
            .age-card.selected {
                animation: none;
                box-shadow: 0 10px 30px rgba(6, 182, 212, 0.4) !important;
            }
        }

        /* Smooth scroll behavior for entire page */
        html {
            scroll-behavior: smooth;
        }

        /* Ensure smooth transitions on back button */
        .pricing-table-container,
        #value-proposition-professional {
            will-change: opacity, transform;
        }

        /* ==========================================
           FAMILY DISCOUNT CALCULATOR STYLES
           ========================================== */

        /* Calculator child rows */
        .calculator-child-row {
            animation: slideInRight 0.3s ease-out;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Calculator select dropdowns */
        .calculator-select {
            transition: all 0.2s ease;
        }

        .calculator-select:hover {
            border-color: rgba(6, 182, 212, 0.5);
        }

        .calculator-select:focus {
            outline: none;
            border-color: rgba(6, 182, 212, 0.8);
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
        }
    </style>
</head>
<body class="antialiased text-zinc-100">
    <div class="site-background" aria-hidden="true"></div>
    
    <!-- Custom cursor elements -->
    <div class="cursor-ring"></div>
    <svg class="cursor-trail-svg">
        <defs>
            <linearGradient id="trail-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:rgba(6, 182, 212, 0);stop-opacity:0" />
                <stop offset="50%" style="stop-color:rgba(6, 182, 212, 0.6);stop-opacity:1" />
                <stop offset="100%" style="stop-color:rgba(6, 182, 212, 1);stop-opacity:1" />
            </linearGradient>
        </defs>
        <path class="cursor-trail-path" d=""></path>
    </svg>

    <!-- Enhanced Background glow effects -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden" style="z-index: 1;">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1400px] h-[1400px] rounded-full blur-3xl opacity-60"
             style="background: radial-gradient(circle at center, rgba(34, 211, 238, 0.7), rgba(34, 211, 238, 0.3) 40%, transparent 70%);"></div>
        <div class="absolute bottom-0 right-0 w-[900px] h-[900px] translate-x-1/4 translate-y-1/4 rounded-full blur-3xl opacity-50"
             style="background: radial-gradient(circle at center, rgba(236, 72, 153, 0.6), rgba(236, 72, 153, 0.2) 40%, transparent 70%);"></div>
        <div class="absolute top-1/2 left-0 w-[600px] h-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl opacity-40"
             style="background: radial-gradient(circle at center, rgba(139, 92, 246, 0.5), transparent 60%);"></div>
    </div>

    <!-- Animated background particles -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none" style="z-index: 2;">
        <div class="particle-1 absolute w-2 h-2 bg-cyan-400 rounded-full opacity-30" style="animation: float 20s infinite ease-in-out;"></div>
        <div class="particle-2 absolute w-1 h-1 bg-teal-400 rounded-full opacity-40" style="animation: float 15s infinite ease-in-out; animation-delay: 2s;"></div>
        <div class="particle-3 absolute w-3 h-3 bg-amber-400 rounded-full opacity-20" style="animation: float 25s infinite ease-in-out; animation-delay: 4s;"></div>
    </div>

    <!-- Header -->
    <!-- Header -->
    <header class="bg-black/40 backdrop-blur-lg border-b border-white/20 sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4">
            <div class="flex justify-between items-center">
                <a href="index.html" class="flex items-center gap-4">
                    <img src="New.logov2.gif" alt="AI Kidz Club Robot" class="robot-logo h-12 w-auto">
                    <span class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent">
                        AI Kidz Club
                    </span>
                </a>
                <nav class="hidden md:flex space-x-12 items-center">
                    <a href="index.html" class="text-white hover:text-cyan-400 transition-colors"><span class="nav-link-roll">Home</span></a>
                    <a href="curriculum.html" class="text-white hover:text-cyan-400 transition-colors"><span class="nav-link-roll">Curriculum</span></a>
                    <a href="pricing.html" class="text-white hover:text-cyan-400 transition-colors"><span class="nav-link-roll">Pricing</span></a>
                    <a href="faq.html" class="text-white hover:text-cyan-400 transition-colors"><span class="nav-link-roll">FAQ</span></a>
                    <a href="index-he.html" class="lang-toggle flex items-center gap-1 px-3 py-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-colors" title="עברית">
                        <span>🌐</span>
                        <span class="text-sm font-semibold">HE</span>
                    </a>
                    <a href="index.html#registration-form" class="register-btn ml-2 bg-gradient-to-r from-cyan-500 to-teal-500 text-white font-bold px-6 py-2.5 rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300">
                        Register Now <span class="arrow-roll">→</span>
                    </a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="relative z-10">
        <!-- Hero Section -->
        <section class="py-12 md:py-16 px-4">
            <div class="max-w-4xl mx-auto text-center">
                <div class="fade-in-up">
                    <!-- Unified Container -->
                    <div class="bg-black/40 backdrop-blur-lg rounded-xl p-6 md:p-8 border-2 border-amber-200/30 shadow-2xl">
                        <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
                            <span class="bg-gradient-to-r from-cyan-400 via-cyan-300 to-teal-400 bg-clip-text text-transparent">Pricing & Plans</span>
                        </h1>

                        <!-- Early Bird Banner with Countdown -->
                        <div class="rounded-2xl px-3 py-2">
                            <div class="flex items-center justify-center gap-2 mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <p class="text-amber-400 font-bold text-sm">20% OFF Early Bird Pricing</p>
                            </div>
                            <div class="grid grid-cols-4 gap-2">
                                <div class="bg-black/60 rounded-xl p-2 text-center border border-amber-400/30">
                                    <div id="days" class="text-xl md:text-2xl font-bold text-white">0</div>
                                    <div class="text-xs md:text-sm text-white/80">Days</div>
                                </div>
                                <div class="bg-black/60 rounded-xl p-2 text-center border border-amber-400/30">
                                    <div id="hours" class="text-xl md:text-2xl font-bold text-white">0</div>
                                    <div class="text-xs md:text-sm text-white/80">Hours</div>
                                </div>
                                <div class="bg-black/60 rounded-xl p-2 text-center border border-amber-400/30">
                                    <div id="minutes" class="text-xl md:text-2xl font-bold text-white">0</div>
                                    <div class="text-xs md:text-sm text-white/80">Minutes</div>
                                </div>
                                <div class="bg-black/60 rounded-xl p-2 text-center border border-amber-400/30">
                                    <div id="seconds" class="text-xl md:text-2xl font-bold text-white">0</div>
                                    <div class="text-xs md:text-sm text-white/80">Seconds</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="relative px-6 py-16 min-h-screen">
            <!-- Hero Header -->
            <div class="max-w-6xl mx-auto text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4 fade-in-up">
                    <span class="bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent">Pricing</span> & Plans
                </h1>
                <div class="inline-block bg-gradient-to-r from-red-500/20 to-orange-500/20 border border-red-400/40 rounded-lg px-6 py-3 mb-6 fade-in-up delay-1">
                    <div class="text-red-300 text-lg font-bold mb-1">⏰ 20% OFF Early Bird Pricing</div>
                    <div class="text-amber-300 text-sm">Lock in founders pricing before regular rates begin</div>
                </div>
            </div>

            <!-- Pricing Table -->
            <div class="max-w-6xl mx-auto">
                <div class="overflow-x-auto">
                    <table class="pricing-table w-full bg-black/40 backdrop-blur-lg rounded-xl border border-amber-200/30" style="table-layout: fixed;">
            <!-- Background overlays -->
            <div class="fixed inset-0 z-[1]" style="background: radial-gradient(ellipse at center, transparent 70%, rgba(0,0,0,0.02) 85%, rgba(0,0,0,0.05) 100%); pointer-events: none;"></div>
            <div class="fixed inset-0 z-[2]" style="background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 100%); pointer-events: none;"></div>

            <div class="relative z-10 max-w-md mx-auto">
                <!-- Section Header -->
                <div class="text-center mb-8 fade-in-up" data-scroll>
                    <h1 class="text-2xl font-bold text-white tracking-tight mb-2">AI Club Raanana</h1>
                    <h2 class="text-4xl font-bold text-white tracking-tight mb-4">Pricing & Plans</h2>
                    <div class="bg-gradient-to-r from-red-500/20 to-orange-500/20 border border-red-400/40 rounded-lg p-4 mb-6">
                        <div class="text-center">
                            <div class="text-red-300 text-lg font-bold mb-2">Limited Founders Special!</div>
                            <div class="text-white/90 text-sm mb-3">20% OFF for the first two months!</div>
                            <div class="text-amber-300 text-xs">Lock in founders pricing before regular rates begin</div>
                        </div>
                    </div>

                    <!-- Countdown Timer -->
                    <div class="bg-black/40 backdrop-blur-lg rounded-2xl p-6 shadow-xl border border-red-400/30 mb-6">
                        <div class="text-center mb-4">
                            <div class="text-red-300 text-lg font-semibold mb-2">Offer Ends In:</div>
                        </div>
                        <div class="grid grid-cols-4 gap-2" id="countdown">
                            <div class="bg-gradient-to-b from-red-500/20 to-red-600/20 border border-red-400/30 rounded-lg p-3 text-center">
                                <div class="text-2xl font-bold text-white" id="days">--</div>
                                <div class="text-xs text-red-300">Days</div>
                            </div>
                            <div class="bg-gradient-to-b from-red-500/20 to-red-600/20 border border-red-400/30 rounded-lg p-3 text-center">
                                <div class="text-2xl font-bold text-white" id="hours">--</div>
                                <div class="text-xs text-red-300">Hours</div>
                            </div>
                            <div class="bg-gradient-to-b from-red-500/20 to-red-600/20 border border-red-400/30 rounded-lg p-3 text-center">
                                <div class="text-2xl font-bold text-white" id="minutes">--</div>
                                <div class="text-xs text-red-300">Minutes</div>
                            </div>
                            <div class="bg-gradient-to-b from-red-500/20 to-red-600/20 border border-red-400/30 rounded-lg p-3 text-center">
                                <div class="text-2xl font-bold text-white" id="seconds">--</div>
                                <div class="text-xs text-red-300">Seconds</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Choose Your Plan Section -->
                <div class="text-center mb-6 fade-in-up delay-1" data-scroll>
                    <h3 class="text-3xl font-bold text-white tracking-tight mb-6">Choose Your Plan</h3>
                </div>

                <!-- Unified Pricing Container -->
                <div class="space-y-4 mb-8" id="pricing-plans">
                    <!-- Monthly Plan -->
